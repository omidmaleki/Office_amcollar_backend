    }
    location /admin/sms/static/ {
        proxy_pass http://sms_backend/static/;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    location /admin/sms/media/ {
        proxy_pass http://sms_backend/media/;
        proxy_set_header Host $host;
        expires 1d;
        add_header Cache-Control "public";
        access_log off;
    }

    # VET ADMIN (از قبل داشتی، نگه داشتم)
    location /admin/vet/ {
        proxy_pass http://vet_backend/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /admin/vet;
        proxy_set_header X-Forwarded-Prefix /admin/vet;
        proxy_redirect /admin/ /admin/vet/;
        sub_filter_once off;
        sub_filter_types text/html text/css text/javascript application/javascript;
        sub_filter "/admin/" "/admin/vet/";
        sub_filter "/static/" "/admin/vet/static/";
        sub_filter "/media/" "/admin/vet/media/";
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
    location /admin/vet/static/ {
        proxy_pass http://vet_backend/static/;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;

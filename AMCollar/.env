# Database (strong password بذار!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password_here  # تغییر بده، مثلاً AmCollarDB2025!
POSTGRES_DB=amcollar

# Redis (برای Celery و cache)
REDIS_PASSWORD=your_strong_redis_password_here  # تغییر بده، مثلاً RedisAmCollar2025!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery (با Redis password آپدیت شده)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# Kafka (اگر env خاص نیاز داری)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# SMS Service
SMS_IR_API_KEY=your_sms_ir_api_key_here  # از پنل SMS.ir بگیر و بذار
SMS_IR_SENDER=your_sender_number_here  # مثلاً 3000505

# Support
SUPPORT_MOBILE=09331737360

# Frontend/Next.js (اگر env خاص مثل API base URL نیاز داری)
NEXT_PUBLIC_API_URL=http://localhost:80/api  # برای فرانت، API calls به /api/ (nginx prefix)

# General Django (DEBUG=False در production)
DJANGO_DEBUG=False
SECRET_KEY=your_django_secret_key_here  # برای هر سرویس Django، اگر shared، یکی بذار؛ وگرنه per-service

# Email (اگر نیاز داری)
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=true
#EMAIL_HOST_USER=your_email@gmail.com
#EMAIL_HOST_PASSWORD=your_app_password_here